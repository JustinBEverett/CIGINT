# Copy this file to `.env` and replace the placeholders with real values.

# Connection string for PostgreSQL. Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# The app's own base URL for this environment, used to build absolute
# redirect URLs (e.g. after the OAuth callback). Set per-environment —
# locally this is your dev server; in Vercel's dashboard, set this under
# Production env vars to the deployed domain instead of committing a
# value here.
APP_ORIGIN="http://localhost:3000"

# Strava
#
# Strava only allows one Authorization Callback Domain per app, so
# STRAVA_REDIRECT_URI has to match whatever domain this environment
# actually runs on — set it per environment the same way as APP_ORIGIN.
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_REDIRECT_URI="http://localhost:3000/api/strava/callback"
STRAVA_SCOPE=""

# Local development only. Set this to your own User.id (query it from the
# DB after a real login through production) to skip the cookie/OAuth flow
# entirely and act as that user locally — works around Strava's
# one-callback-domain limit rather than needing a second Strava app.
# Never set this in Vercel: the app refuses to honor it whenever
# NODE_ENV is "production", regardless of its value.
DEV_USER_ID=""
