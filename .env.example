# Copy this file to `.env` and replace the placeholders with real values.

# Connection string for PostgreSQL. Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# The app's own base URL for this environment, used to build absolute
# redirect URLs (e.g. after the OAuth callback). Set per-environment —
# locally this is your dev server; in Vercel's dashboard, set this under
# Production env vars to the deployed domain instead of committing a
# value here.
APP_ORIGIN="http://localhost:3000"

# Strava
#
# STRAVA_REDIRECT_URI must be on this environment's own domain. Strava
# accepts localhost callbacks for development in addition to the
# Authorization Callback Domain set in the app's settings, so local login
# works with the same Strava app as production. Set it per environment the
# same way as APP_ORIGIN.
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_REDIRECT_URI="http://localhost:3000/api/strava/callback"
# Comma-separated. Leaving it empty requests no activity access, and every
# sync fails.
STRAVA_SCOPE="read,activity:read_all"
